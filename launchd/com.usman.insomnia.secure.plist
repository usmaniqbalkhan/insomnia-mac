<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.usman.insomnia.secure</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/insomnia</string>
		<string>secure-monitor</string>
	</array>
	<!-- Runs only while Secure Background Mode is on, and is restarted if it dies. -->
	<key>KeepAlive</key>
	<dict>
		<key>PathState</key>
		<dict>
			<key>__HOME__/Library/Application Support/Insomnia/secure</key>
			<true/>
		</dict>
	</dict>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/Insomnia/secure.err.log</string>
</dict>
</plist>
